# Dar Al-Rahma – Webseite: Einstellungen für einen Apache-Server (z. B. beim späteren eigenen Server).
# Hinweis: GitHub Pages wertet diese Datei NICHT aus. Sie wirkt erst auf einem Apache-Webserver.

# Keine Ordnerinhalte auflisten, eigene Fehlerseite
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

# Interne Dateien nie ausliefern (Arbeitsnotizen, Skripte, Rohmaterial)
<FilesMatch "(^\.|\.(md|py|bat|ps1|log|bak|orig|sql|sqlite)$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(gazahilfspool/roh|werkzeug|katzen|kids4hope|medical-point|satzung)/

# Sicherheitsköpfe
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Inhalte nur von der eigenen Seite. connect-src: Adresse der Spenden-Zentrale ergänzen, sobald sie online ist.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  # Nur aktivieren, wenn die Seite dauerhaft über HTTPS läuft:
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Immer HTTPS (erst aktivieren, wenn ein Zertifikat eingerichtet ist)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Zwischenspeichern: Bilder, Videos und Schriften lange, Seiten kurz
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ECHTER Passwortschutz (Server-Ebene) – ersetzt den reinen Sichtschutz aus sperre.js.
# Einrichten auf dem Server:
#   1) htpasswd -c /etc/apache2/.htpasswd-daralrahma besucher      (Passwort eingeben)
#   2) Die vier Zeilen unten aktivieren (# entfernen) und Apache neu laden.
# Die .htpasswd-Datei liegt AUSSERHALB des Webordners und kommt nie ins Git.
# AuthType Basic
# AuthName "Dar Al-Rahma – noch nicht öffentlich"
# AuthUserFile /etc/apache2/.htpasswd-daralrahma
# Require valid-user
